import time
import torch
import torch.nn as nn
from lib.utils import AverageMeter, prGreen
import math
import numpy as np
import copy
import json



class ECGChannelPruningEnv:
    ""
    
    Constraint groups (layers that must share indices):
    - Stage 1: layers 0, 2, 4 (Conv1, L1B0.conv2, L1B1.conv2)
    - Stage 2: layers 6, 7, 9 (L2B0.conv2, L2B0.down, L2B1.conv2)
    - Stage 3: layers 11, 12, 14 (L3B0.conv2, L3B0.down, L3B1.conv2)
    - Stage 4: layers 16, 17, 19 (L4B0.conv2, L4B0.down, L4B1.conv2)
    """

    def __init__(self, model, checkpoint, data_path, preserve_ratio, args, n_data_worker=4,
                 batch_size=256, export_model=False, use_new_input=False):
        
        self.prunable_layer_types = [torch.nn.modules.conv.Conv1d]
        self.model = model
        self.checkpoint = checkpoint
        self.n_data_worker = n_data_worker
        self.batch_size = batch_size
        self.data_path = data_path
        self.preserve_ratio = preserve_ratio
        self.args = args
        self.lbound = args.lbound
        self.rbound = args.rbound
        self.use_real_val = args.use_real_val if hasattr(args, 'use_real_val') else False
        self.n_calibration_batches = args.n_calibration_batches
        self.n_points_per_layer = args.n_points_per_layer
        self.channel_round = args.channel_round
        self.acc_metric = args.acc_metric
        self.export_model = export_model
        self.use_new_input = use_new_input
        self.export_path = './export'

        assert self.preserve_ratio > self.lbound

        self._init_data()
        self._build_index()
        self._build_constrained_structure()
        
        self.n_prunable_layer = len(self.free_var_idx)

        self._extract_layer_information()
        self.org_flops = sum(self.flops_list)
        self.org_model_size = sum(self.wsize_list)
        self._build_state_embedding()

        self.reset()
        self.org_acc = self._validate(self.val_loader, self.model)
        print('=> original acc (AUROC * 100): {:.3f}%'.format(self.org_acc))
        print('=> original weight size: {:.4f} M param'.format(self.org_model_size * 1. / 1e6))
        print('=> original FLOPs: {:.4f} M'.format(self.org_flops * 1. / 1e6))

        self.expected_preserve_computation = self.preserve_ratio * self.org_flops

        if args.reward in REWARD_FUNCTIONS:
            self.reward = REWARD_FUNCTIONS[args.reward]
        else:
            raise ValueError(f"Unknown reward: {args.reward}")

        self.best_reward = -math.inf
        self.best_strategy = None
        self.best_d_prime_list = None
        self.best_output_channels = None
        self.best_preserve_indices = None
        
        self.org_w_size = sum(self.wsize_list)

    def _build_constrained_structure(self):
        """Build the 12 free variables for constrained pruning."""
        self.free_var_orig_channels = [64, 64, 64, 128, 128, 128, 256, 256, 256, 512, 512, 512]
        self.free_var_names = [
            'stage1_out', 'l1b0_mid', 'l1b1_mid',
            'l2b0_mid', 'stage2_out', 'l2b1_mid',
            'l3b0_mid', 'stage3_out', 'l3b1_mid',
            'l4b0_mid', 'stage4_out', 'l4b1_mid',
        ]
        self.free_var_idx = list(range(12))
        
        # Define constraint groups: which 20-layer indices share the same channels
        # These layers MUST use the SAME channel indices
        self.constraint_groups = {
            'stage1': [0, 2, 4],      # Conv1, L1B0.conv2, L1B1.conv2
            'stage2': [6, 7, 9],      # L2B0.conv2, L2B0.down, L2B1.conv2
            'stage3': [11, 12, 14],   # L3B0.conv2, L3B0.down, L3B1.conv2
            'stage4': [16, 17, 19],   # L4B0.conv2, L4B0.down, L4B1.conv2
        }
        
        # Map from free_var index to which constraint group it controls
        self.free_var_to_constraint = {
            0: 'stage1',  # stage1_out controls layers 0, 2, 4
            4: 'stage2',  # stage2_out controls layers 6, 7, 9
            7: 'stage3',  # stage3_out controls layers 11, 12, 14
            10: 'stage4', # stage4_out controls layers 16, 17, 19
        }
        
        # Map from free_var index to the "source" layer for computing indices
        # (the layer whose weights determine which channels to keep)
        self.free_var_source_layer = {
            0: 0,   # stage1: use Conv1 weights
            4: 6,   # stage2: use L2B0.conv2 weights
            7: 11,  # stage3: use L3B0.conv2 weights
            10: 16, # stage4: use L4B0.conv2 weights
        }
        
        print("\n" + "=" * 60)
        print("CONSTRAINED PRUNING ENVIRONMENT V4")
        print("With JOINT IMPORTANCE for constrained layers")
        print("=" * 60)
        print("\nFree variables:")
        for i, (name, ch) in enumerate(zip(self.free_var_names, self.free_var_orig_channels)):
            print(f"  {i:2d}: {name:12s} (orig: {ch})")
        print("\nConstraint groups (share same indices):")
        for name, layers in self.constraint_groups.items():
            print(f"  {name}: layers {layers}")
        print("=" * 60)

    def _build_index(self):
        """Build index of prunable Conv layers."""
        self.prunable_idx = []
        self.prunable_ops = []
        self.layer_type_dict = {}
        self.buffer_dict = {}
        this_buffer_list = []
        self.org_channels = []

        for i, m in enumerate(self.model.modules()):
            if type(m) == nn.Conv1d:
                if m.groups == m.in_channels and m.groups > 1:
                    this_buffer_list.append(i)
                    continue
                self.prunable_idx.append(i)
                self.prunable_ops.append(m)
                self.layer_type_dict[i] = type(m)
                self.buffer_dict[i] = this_buffer_list
                this_buffer_list = []
                self.org_channels.append(m.in_channels)

        self.buffer_idx = []
        for k, v in self.buffer_dict.items():
            self.buffer_idx += v

        print(f'=> Found {len(self.prunable_idx)} Conv layers')
        print(f'=> Original channels: {self.org_channels}')

        assert len(self.prunable_idx) == 20, f"Expected 20 conv layers, got {len(self.prunable_idx)}"

        m_list = list(self.model.modules())
        print("Conv order check (layer_idx, module_idx, in->out, k, stride):")
        for li, op_idx in enumerate(self.prunable_idx):
            op = m_list[op_idx]
            print(li, op_idx, f"{op.in_channels}->{op.out_channels}", f"k={op.kernel_size}", f"s={op.stride}")

    def step(self, action):
        """Take a step - agent decides one free variable at a time."""
        action = float(np.clip(action, self.lbound, self.rbound))
        action = self._action_wall(action)
        
        self.strategy.append(action)
        
        orig_ch = self.free_var_orig_channels[self.cur_ind]
        d_prime = int(np.ceil(orig_ch * action / self.channel_round) * self.channel_round)
        d_prime = max(d_prime, self.channel_round)
        d_prime = min(d_prime, orig_ch)
        self.d_prime_list.append(d_prime)
        
        if self.export_model:
            print(f'# Free var {self.cur_ind} ({self.free_var_names[self.cur_ind]}): '
                  f'ratio={action:.4f}, d_prime={d_prime}')

        if self._is_final_layer():
            assert len(self.strategy) == len(self.free_var_idx)
            
            # Convert to layer outputs
            self.output_channels = self._free_vars_to_layer_outputs(self.d_prime_list)
            
            # Apply pseudo-pruning with PROPERLY CONSTRAINED indices
            preserve_indices = self._apply_constrained_pseudo_pruning(self.output_channels)
            
            current_flops = self._calculate_pruned_flops(self.output_channels)
            acc = self._validate(self.val_loader, self.model)
            
            compress_ratio = current_flops / self.org_flops
            info_set = {
                'compress_ratio': compress_ratio, 
                'accuracy': acc,
                'strategy': self.strategy.copy(),
                'output_channels': self.output_channels.copy(),
                'preserve_indices': preserve_indices,
            }
            
            reward = self.reward(self, acc, current_flops)

            if reward > self.best_reward:
                self.best_reward = reward
                self.best_strategy = self.strategy.copy()
                self.best_d_prime_list = self.d_prime_list.copy()
                self.best_output_channels = self.output_channels.copy()
                self.best_preserve_indices = preserve_indices
                
                prGreen(f'New best reward: {self.best_reward:.4f}, acc: {acc:.4f}, '
                        f'compress: {compress_ratio:.4f}')
                prGreen(f'New best strategy: {self.best_strategy}')
                prGreen(f'New best d_primes (12 free vars): {self.best_d_prime_list}')
                
                self._save_best_indices()

            obs = self.layer_embedding[self.cur_ind, :].copy()
            done = True
            return obs, reward, done, info_set

        info_set = None
        reward = 0
        done = False
        self.cur_ind += 1
        
        self.layer_embedding[self.cur_ind][-3] = self._cur_reduced() / self.org_flops
        self.layer_embedding[self.cur_ind][-2] = self._remaining_flops() / self.org_flops
        self.layer_embedding[self.cur_ind][-1] = self.strategy[-1]
        obs = self.layer_embedding[self.cur_ind, :].copy()

        return obs, reward, done, info_set

    def _free_vars_to_layer_outputs(self, d_primes):
        """Convert 12 free variables to 20 layer output channels."""
        s1, m1a, m1b = d_primes[0], d_primes[1], d_primes[2]
        m2a, s2, m2b = d_primes[3], d_primes[4], d_primes[5]
        m3a, s3, m3b = d_primes[6], d_primes[7], d_primes[8]
        m4a, s4, m4b = d_primes[9], d_primes[10], d_primes[11]
        
        return [
            s1,   # 0:  Conv1.out
            m1a,  # 1:  L1B0.conv1.out
            s1,   # 2:  L1B0.conv2.out
            m1b,  # 3:  L1B1.conv1.out
            s1,   # 4:  L1B1.conv2.out
            m2a,  # 5:  L2B0.conv1.out
            s2,   # 6:  L2B0.conv2.out
            s2,   # 7:  L2B0.down.out
            m2b,  # 8:  L2B1.conv1.out
            s2,   # 9:  L2B1.conv2.out
            m3a,  # 10: L3B0.conv1.out
            s3,   # 11: L3B0.conv2.out
            s3,   # 12: L3B0.down.out
            m3b,  # 13: L3B1.conv1.out
            s3,   # 14: L3B1.conv2.out
            m4a,  # 15: L4B0.conv1.out
            s4,   # 16: L4B0.conv2.out
            s4,   # 17: L4B0.down.out
            m4b,  # 18: L4B1.conv1.out
            s4,   # 19: L4B1.conv2.out
        ]

    def _apply_constrained_pseudo_pruning(self, output_channels):
        """
        Apply pseudo-pruning with JOINT IMPORTANCE for constrained layers.
        
        V4 IMPROVEMENT:
        - For constrained layer groups (skip connections), compute importance
          from ALL layers in the group, not just the first layer.
        - This is more optimal because all layers contribute to channel selection.
        
        Returns:
            preserve_indices: dict mapping layer_idx -> list of kept OUTPUT channel indices
        """
        self.model.load_state_dict(self.checkpoint)
        m_list = list(self.model.modules())
        
        preserve_indices = {}
        
        # Helper to compute indices for a SINGLE layer (bottlenecks)
        def compute_single_indices(layer_idx, input_indices=None):
            op = m_list[self.prunable_idx[layer_idx]]
            target_out = output_channels[layer_idx]
            orig_out = op.weight.size(0)
            
            if target_out >= orig_out:
                return list(range(orig_out))
            
            weight = op.weight.data.cpu().numpy()
            
            if input_indices is not None and len(input_indices) < weight.shape[1]:
                weight_subset = weight[:, input_indices, :]
            else:
                weight_subset = weight
            
            importance = np.abs(weight_subset).sum(axis=(1, 2))
            sorted_idx = np.argsort(-importance)
            return sorted(sorted_idx[:target_out].tolist())
        
        # Helper to compute JOINT indices for constrained layers
        def compute_joint_indices(layer_indices, input_indices_per_layer, target_out, orig_out):
            """
            Compute indices using JOINT importance from multiple layers.
            
            Args:
                layer_indices: list of layer indices in constraint group
                input_indices_per_layer: dict mapping layer_idx -> input_indices
                target_out: number of channels to keep
                orig_out: original number of channels
            """
            if target_out >= orig_out:
                return list(range(orig_out))
            
            all_importance = []
            
            for layer_idx in layer_indices:
                op = m_list[self.prunable_idx[layer_idx]]
                weight = op.weight.data.cpu().numpy()
                
                # Get input indices for this layer
                input_idx = input_indices_per_layer.get(layer_idx)
                if input_idx is not None and len(input_idx) < weight.shape[1]:
                    weight_subset = weight[:, input_idx, :]
                else:
                    weight_subset = weight
                
                # Compute importance
                importance = np.abs(weight_subset).sum(axis=(1, 2))
                
                # Normalize so each layer contributes equally
                if importance.sum() > 0:
                    importance = importance / importance.sum()
                
                all_importance.append(importance)
            
            # Average importance across all layers in the group
            joint_importance = np.mean(all_importance, axis=0)
            
            sorted_idx = np.argsort(-joint_importance)
            return sorted(sorted_idx[:target_out].tolist())
        
        # ================================================================
        # STAGE 1: Layers [0, 2, 4] use JOINT importance
        # ================================================================
        # Layer 0 input: 12 ECG leads
        # Layer 2 input: output of layer 1 (bottleneck) - but layer 1 not pruned yet
        # Layer 4 input: output of layer 3 (bottleneck) - but layer 3 not pruned yet
        # 
        # For simplicity, use layer 0's input (12 channels) for all
        # since layers 2 and 4 take bottleneck outputs which vary
        stage1_input_indices = {
            0: list(range(12)),  # Conv1: 12 ECG leads
            2: None,             # L1B0.conv2: bottleneck output (use all)
            4: None,             # L1B1.conv2: bottleneck output (use all)
        }
        stage1_indices = compute_joint_indices(
            layer_indices=[0, 2, 4],
            input_indices_per_layer=stage1_input_indices,
            target_out=output_channels[0],
            orig_out=64
        )
        
        preserve_indices[0] = stage1_indices
        preserve_indices[2] = stage1_indices
        preserve_indices[4] = stage1_indices
        
        # ================================================================
        # LAYER 1 BOTTLENECKS (independent, not constrained)
        # ================================================================
        preserve_indices[1] = compute_single_indices(1, input_indices=stage1_indices)
        preserve_indices[3] = compute_single_indices(3, input_indices=stage1_indices)
        
        # ================================================================
        # STAGE 2: Layers [6, 7, 9] use JOINT importance
        # ================================================================
        # First compute bottleneck 5 (needed for input to layer 6)
        preserve_indices[5] = compute_single_indices(5, input_indices=stage1_indices)
        
        # Joint importance for stage 2
        stage2_input_indices = {
            6: preserve_indices[5],  # L2B0.conv2: input from bottleneck 5
            7: stage1_indices,       # L2B0.down: input from stage 1
            9: None,                 # L2B1.conv2: input from bottleneck 8 (not yet computed)
        }
        stage2_indices = compute_joint_indices(
            layer_indices=[6, 7, 9],
            input_indices_per_layer=stage2_input_indices,
            target_out=output_channels[6],
            orig_out=128
        )
        
        preserve_indices[6] = stage2_indices
        preserve_indices[7] = stage2_indices
        preserve_indices[9] = stage2_indices
        
        # Bottleneck 8
        preserve_indices[8] = compute_single_indices(8, input_indices=stage2_indices)
        
        # ================================================================
        # STAGE 3: Layers [11, 12, 14] use JOINT importance
        # ================================================================
        preserve_indices[10] = compute_single_indices(10, input_indices=stage2_indices)
        
        stage3_input_indices = {
            11: preserve_indices[10],  # L3B0.conv2: input from bottleneck 10
            12: stage2_indices,        # L3B0.down: input from stage 2
            14: None,                  # L3B1.conv2: input from bottleneck 13
        }
        stage3_indices = compute_joint_indices(
            layer_indices=[11, 12, 14],
            input_indices_per_layer=stage3_input_indices,
            target_out=output_channels[11],
            orig_out=256
        )
        
        preserve_indices[11] = stage3_indices
        preserve_indices[12] = stage3_indices
        preserve_indices[14] = stage3_indices
        
        # Bottleneck 13
        preserve_indices[13] = compute_single_indices(13, input_indices=stage3_indices)
        
        # ================================================================
        # STAGE 4: Layers [16, 17, 19] use JOINT importance
        # ================================================================
        preserve_indices[15] = compute_single_indices(15, input_indices=stage3_indices)
        
        stage4_input_indices = {
            16: preserve_indices[15],  # L4B0.conv2: input from bottleneck 15
            17: stage3_indices,        # L4B0.down: input from stage 3
            19: None,                  # L4B1.conv2: input from bottleneck 18
        }
        stage4_indices = compute_joint_indices(
            layer_indices=[16, 17, 19],
            input_indices_per_layer=stage4_input_indices,
            target_out=output_channels[16],
            orig_out=512
        )
        
        preserve_indices[16] = stage4_indices
        preserve_indices[17] = stage4_indices
        preserve_indices[19] = stage4_indices
        
        # Bottleneck 18
        preserve_indices[18] = compute_single_indices(18, input_indices=stage4_indices)
        
        # Now apply pseudo-pruning (zero out removed channels)
        # IMPORTANT: Must zero BOTH conv weights AND BN gamma/bias!
        # Otherwise BN output won't be zero even when conv output is zero.
        
        # Map conv layer index to corresponding BN module
        conv_to_bn_idx = {
            0: 2,    # conv1 -> bn1
            1: 8,    # layer1.0.conv1 -> layer1.0.bn1
            2: 11,   # layer1.0.conv2 -> layer1.0.bn2
            3: 22,   # layer1.1.conv1 -> layer1.1.bn1
            4: 25,   # layer1.1.conv2 -> layer1.1.bn2
            5: 37,   # layer2.0.conv1 -> layer2.0.bn1
            6: 40,   # layer2.0.conv2 -> layer2.0.bn2
            7: 50,   # layer2.0.downsample.0 -> layer2.0.downsample.1
            8: 54,   # layer2.1.conv1 -> layer2.1.bn1
            9: 57,   # layer2.1.conv2 -> layer2.1.bn2
            10: 69,  # layer3.0.conv1 -> layer3.0.bn1
            11: 72,  # layer3.0.conv2 -> layer3.0.bn2
            12: 82,  # layer3.0.downsample.0 -> layer3.0.downsample.1
            13: 86,  # layer3.1.conv1 -> layer3.1.bn1
            14: 89,  # layer3.1.conv2 -> layer3.1.bn2
            15: 101, # layer4.0.conv1 -> layer4.0.bn1
            16: 104, # layer4.0.conv2 -> layer4.0.bn2
            17: 114, # layer4.0.downsample.0 -> layer4.0.downsample.1
            18: 118, # layer4.1.conv1 -> layer4.1.bn1
            19: 121, # layer4.1.conv2 -> layer4.1.bn2
        }
        
        for layer_idx in range(20):
            op = m_list[self.prunable_idx[layer_idx]]
            orig_out = op.weight.size(0)
            keep_idx = preserve_indices[layer_idx]
            
            if len(keep_idx) < orig_out:
                keep_set = set(keep_idx)
                remove_idx = [i for i in range(orig_out) if i not in keep_set]
                
                # Zero conv weights
                op.weight.data[remove_idx, :, :] = 0
                
                # Zero BN gamma and bias
                bn_idx = conv_to_bn_idx.get(layer_idx)
                if bn_idx is not None:
                    bn = m_list[bn_idx]
                    if hasattr(bn, 'weight') and bn.weight is not None:
                        bn.weight.data[remove_idx] = 0
                    if hasattr(bn, 'bias') and bn.bias is not None:
                        bn.bias.data[remove_idx] = 0
        
        return preserve_indices

    def _save_best_indices(self):
        """Save best channel indices to file for export."""
        import os
        os.makedirs(self.export_path, exist_ok=True)
        
        save_data = {
            'd_primes': self.best_d_prime_list,
            'output_channels': self.best_output_channels,
            'preserve_indices': {str(k): v for k, v in self.best_preserve_indices.items()},
            'strategy': [float(s) for s in self.best_strategy],
            'reward': float(self.best_reward),
            'constraint_groups': self.constraint_groups,  # Include for verification
        }
        
        save_path = os.path.join(self.export_path, 'best_pruning_indices.json')
        with open(save_path, 'w') as f:
            json.dump(save_data, f, indent=2)
        
        print(f"Saved best indices to {save_path}")

    def _calculate_pruned_flops(self, output_channels):
        """Calculate FLOPs for pruned model."""
        total_flops = 0
        
        # Build input channels based on data flow
        input_channels = [12]  # Conv1 input
        input_channels.append(output_channels[0])   # L1B0.conv1 input = Conv1 output
        input_channels.append(output_channels[1])   # L1B0.conv2 input = L1B0.conv1 output
        input_channels.append(output_channels[2])   # L1B1.conv1 input = L1B0.conv2 output
        input_channels.append(output_channels[3])   # L1B1.conv2 input = L1B1.conv1 output
        input_channels.append(output_channels[4])   # L2B0.conv1 input = L1B1.conv2 output
        input_channels.append(output_channels[5])   # L2B0.conv2 input = L2B0.conv1 output
        input_channels.append(output_channels[4])   # L2B0.down input = L1B1.conv2 output
        input_channels.append(output_channels[6])   # L2B1.conv1 input = L2B0.conv2 output
        input_channels.append(output_channels[8])   # L2B1.conv2 input = L2B1.conv1 output
        input_channels.append(output_channels[9])   # L3B0.conv1 input = L2B1.conv2 output
        input_channels.append(output_channels[10])  # L3B0.conv2 input = L3B0.conv1 output
        input_channels.append(output_channels[9])   # L3B0.down input = L2B1.conv2 output
        input_channels.append(output_channels[11])  # L3B1.conv1 input = L3B0.conv2 output
        input_channels.append(output_channels[13])  # L3B1.conv2 input = L3B1.conv1 output
        input_channels.append(output_channels[14])  # L4B0.conv1 input = L3B1.conv2 output
        input_channels.append(output_channels[15])  # L4B0.conv2 input = L4B0.conv1 output
        input_channels.append(output_channels[14])  # L4B0.down input = L3B1.conv2 output
        input_channels.append(output_channels[16])  # L4B1.conv1 input = L4B0.conv2 output
        input_channels.append(output_channels[18])  # L4B1.conv2 input = L4B1.conv1 output
        
        m_list = list(self.model.modules())
        for i, op_idx in enumerate(self.prunable_idx):
            op = m_list[op_idx]
            in_ch = input_channels[i]
            out_ch = output_channels[i]
            
            if op_idx in self.layer_info_dict:
                orig_flops = self.layer_info_dict[op_idx]['flops']
                orig_out = op.weight.size(0)
                orig_in = op.weight.size(1)
                scale = (out_ch / orig_out) * (in_ch / orig_in)
                total_flops += orig_flops * scale
        
        return total_flops

    def reset(self):
        self.model.load_state_dict(self.checkpoint)
        self.cur_ind = 0
        self.strategy = []
        self.d_prime_list = []
        self.output_channels = []
        
        self.layer_embedding[:, -1] = 1.
        self.layer_embedding[:, -2] = 0.
        self.layer_embedding[:, -3] = 0.
        
        return self.layer_embedding[0].copy()

    def _is_final_layer(self):
        return self.cur_ind == len(self.free_var_idx) - 1

    def _action_wall(self, action):
        return np.clip(action, self.lbound, self.rbound)

    def _cur_reduced(self):
        if len(self.d_prime_list) == 0:
            return 0
        reduction = 0
        for i, d_prime in enumerate(self.d_prime_list):
            orig = self.free_var_orig_channels[i]
            reduction += (1 - d_prime / orig) * (self.org_flops / 12)
        return reduction

    def _remaining_flops(self):
        return self.org_flops - self._cur_reduced()

    def _collate_fn(self, batch):
        ecgs, ags, labels = zip(*batch)
        target_length = 4096
        processed_ecgs = []
        for ecg in ecgs:
            if isinstance(ecg, np.ndarray):
                ecg = torch.from_numpy(ecg)
            if ecg.shape[1] > target_length:
                ecg = ecg[:, :target_length]
            elif ecg.shape[1] < target_length:
                padding = torch.zeros(ecg.shape[0], target_length - ecg.shape[1])
                ecg = torch.cat([ecg, padding], dim=1)
            processed_ecgs.append(ecg)
        ecgs = torch.stack(processed_ecgs).float()
        ags = torch.stack([ag if isinstance(ag, torch.Tensor) else torch.from_numpy(ag) for ag in ags]).float()
        labels = torch.stack([label if isinstance(label, torch.Tensor) else torch.from_numpy(label) for label in labels]).float()
        return ecgs, ags, labels

    def _init_data(self):
        from src.dataloader.dataset import ECGDataset
        from src.dataloader.transforms import Compose, ValClip, Normalize, Retype
        from torch.utils.data import DataLoader

        transform = Compose([ValClip(w=4096), Normalize('0-1'), Retype()], p=1.0)
        train_dataset = ECGDataset(self.data_path['train'], transform)
        val_dataset = ECGDataset(self.data_path['val'], transform)

        self.train_loader = DataLoader(train_dataset, batch_size=self.batch_size,
                                       shuffle=False, num_workers=0,
                                       pin_memory=True, drop_last=True,
                                       collate_fn=self._collate_fn)
        self.val_loader = DataLoader(val_dataset, batch_size=self.batch_size,
                                     shuffle=False, num_workers=0,
                                     pin_memory=True, drop_last=False,
                                     collate_fn=self._collate_fn)

    def _extract_layer_information(self):
        m_list = list(self.model.modules())
        self.layer_info_dict = dict()
        self.wsize_list = []
        self.flops_list = []

        from lib.utils import measure_layer_for_pruning

        def new_forward(m):
            def lambda_forward(x):
                m.input_feat = x.clone()
                measure_layer_for_pruning(m, x)
                y = m.old_forward(x)
                m.output_feat = y.clone()
                return y
            return lambda_forward

        for idx in self.prunable_idx:
            m = m_list[idx]
            m.old_forward = m.forward
            m.forward = new_forward(m)

        print('=> Extracting layer information...')
        with torch.no_grad():
            for i_b, (input, ag, target) in enumerate(self.train_loader):
                if i_b == self.n_calibration_batches:
                    break
                input_var = input.cuda()
                ag_var = ag.cuda()
                _ = self.model(input_var, ag_var)

                if i_b == 0:
                    for idx in self.prunable_idx:
                        self.layer_info_dict[idx] = dict()
                        self.layer_info_dict[idx]['params'] = m_list[idx].params
                        self.layer_info_dict[idx]['flops'] = m_list[idx].flops
                        self.wsize_list.append(m_list[idx].params)
                        self.flops_list.append(m_list[idx].flops)

        for idx in self.prunable_idx:
            m = m_list[idx]
            m.forward = m.old_forward
            delattr(m, 'old_forward')

    def _build_state_embedding(self):
        layer_embedding = []
        for i in self.free_var_idx:
            this_state = [
                i,
                0 if i in [0, 4, 7, 10] else 1,  # Is stage output?
                self.free_var_orig_channels[i],
                self.free_var_orig_channels[i],
                1, 7,
                self.org_flops / 12,
                0., 0., 1.
            ]
            layer_embedding.append(np.array(this_state))

        layer_embedding = np.array(layer_embedding, 'float')
        print(f'=> State embedding shape: {layer_embedding.shape}')

        for i in range(layer_embedding.shape[1]):
            fmin = min(layer_embedding[:, i])
            fmax = max(layer_embedding[:, i])
            if fmax - fmin > 0:
                layer_embedding[:, i] = (layer_embedding[:, i] - fmin) / (fmax - fmin)

        self.layer_embedding = layer_embedding

    def _validate(self, val_loader, model, verbose=False):
        criterion = nn.BCEWithLogitsLoss().cuda()
        sigmoid = nn.Sigmoid().cuda()
        model.eval()
        all_labels, all_preds = [], []

        with torch.no_grad():
            for i, (input, ag, target) in enumerate(val_loader):
                target = target.cuda(non_blocking=True)
                input_var = input.cuda()
                ag_var = ag.cuda()
                output = model(input_var, ag_var)
                pred = sigmoid(output)
                all_labels.append(target.cpu().numpy())
                all_preds.append(pred.cpu().numpy())

        all_labels = np.vstack(all_labels)
        all_preds = np.vstack(all_preds)

        from sklearn.metrics import roc_auc_score
        try:
            valid_cols = all_labels.sum(axis=0) > 0
            if valid_cols.sum() > 0:
                micro_auroc = roc_auc_score(all_labels[:, valid_cols], all_preds[:, valid_cols], average='micro')
            else:
                micro_auroc = 0.5
        except:
            micro_auroc = 0.5

        return micro_auroc * 100

